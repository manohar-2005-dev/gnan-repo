# ============================================================
# NutriFlow AI — Environment Variables Configuration
# ============================================================
# Copy this file to .env or .env.local and fill in your real values.
# DO NOT commit secret keys or tokens to version control.
# ============================================================

# ─── Frontend Environment Variables (Vite) ────────────────────
# Supabase Project URL for authentication
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public API Key
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Swiggy OAuth Callback URI (Must match registered redirect URI)
VITE_SWIGGY_REDIRECT_URI=http://localhost:5173/auth/callback/

# ─── Backend Environment Variables (Express API Server) ────────
# Express Server Listen Port
PORT=8080

# Supabase JWT Verification Parameters
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini API Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSy...

# PostgreSQL Connection String (Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nutriflow

# Swiggy OAuth 2.1 PKCE Settings
# Note: Swiggy uses Dynamic Client Registration (DCR) via POST /auth/register
SWIGGY_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback/

# Node Environment
NODE_ENV=development
